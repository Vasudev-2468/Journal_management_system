# Copy to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit real secrets.

# ── Basics ────────────────────────────────────────────────
region              = "us-east-1"
project             = "jgair"
environment         = "prod"
instance_type       = "t3.small"          # t3.micro if free tier + you added swap
root_volume_size_gb = 30

# ── SSH access ────────────────────────────────────────────
# Create this key pair in the EC2 console first, then reference by name.
ssh_key_name = "jgair-prod-key"

# Lock SSH to your public IP. Find it with: curl ifconfig.me
# Format: "1.2.3.4/32". Use "0.0.0.0/0" only if you accept SSH from anywhere.
ssh_ingress_cidr = "1.2.3.4/32"

# ── S3 bucket (must be globally unique) ───────────────────
s3_bucket_name = "jgair-manuscripts-prod-<random-suffix>"

# ── App repo ──────────────────────────────────────────────
github_repo_url = "https://github.com/Vasudev-2468/Journal_management_system.git"

# ── Architecture: where does the frontend live? ───────────
# false (default) → frontend on AWS Amplify (uses amplify.yml at repo root).
#                   EC2 only runs the API. Set `frontend_public_url` below.
# true            → frontend runs on the EC2 next to the backend. Set `domain`
#                   below and skip Amplify.
deploy_frontend_on_ec2 = false

# ── DNS / URLs ────────────────────────────────────────────
# ALWAYS required: the API's public hostname. Point an A record at the
# elastic_ip output AFTER apply.
api_domain = "api.jgair.example.com"

# Required ONLY when deploy_frontend_on_ec2 = true (leave empty otherwise).
domain = ""

# Required ONLY when deploy_frontend_on_ec2 = false (Amplify path).
# Set this to your Amplify default URL (https://main.d1abcxyz.amplifyapp.com)
# or the custom domain you attached in Amplify. Include the scheme, no
# trailing slash.
frontend_public_url = "https://main.REPLACE_ME.amplifyapp.com"

# ── Secrets — generate real values before apply ───────────
# postgres_password: any strong string
# secret_key:        openssl rand -hex 32
postgres_password = "REPLACE_ME_strong_random_password"
secret_key        = "REPLACE_ME_run_openssl_rand_hex_32"

# Optional — leave blank to disable the corresponding features.
openai_api_key      = ""
anthropic_api_key   = ""
sendgrid_api_key    = ""
sendgrid_from_email = ""
