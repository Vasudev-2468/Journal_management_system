# Copy to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit real secrets.

# ── Basics ────────────────────────────────────────────────
region        = "us-east-1"
project       = "jgair"
environment   = "prod"
instance_type = "t3.small"          # t3.micro if free tier + you added swap
root_volume_size_gb = 30

# ── SSH access ────────────────────────────────────────────
# Create this key pair in the EC2 console first, then reference by name.
ssh_key_name = "jgair-prod-key"

# Lock SSH to your public IP. Find it with: curl ifconfig.me
# Format: "1.2.3.4/32". Use "0.0.0.0/0" only if you accept SSH from anywhere.
ssh_ingress_cidr = "1.2.3.4/32"

# ── S3 bucket (must be globally unique) ───────────────────
s3_bucket_name = "jgair-manuscripts-prod-<random-suffix>"

# ── App repo ──────────────────────────────────────────────
# REQUIRED. Point this at YOUR fork; there is no default anymore, so
# `terraform apply` without setting this fails at plan time.
github_repo_url = "https://github.com/YOUR_USER/Journal_management_system.git"

# ── DNS ───────────────────────────────────────────────────
# Point A records for these at the elastic_ip output AFTER apply.
domain     = "jgair.example.com"
api_domain = "api.jgair.example.com"

# ── Secrets — generate real values before apply ───────────
# postgres_password: any strong string
# secret_key:        openssl rand -hex 32
postgres_password = "REPLACE_ME_strong_random_password"
secret_key        = "REPLACE_ME_run_openssl_rand_hex_32"

# Optional — leave blank to disable the corresponding features.
openai_api_key      = ""
anthropic_api_key   = ""
sendgrid_api_key    = ""
sendgrid_from_email = ""
