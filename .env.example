# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://journal_user:change_me@localhost:5432/journal_db

# ── Authentication / JWT ──────────────────────────────────
SECRET_KEY=change_me_to_a_random_64_char_string__use_openssl_rand_hex_32____
ALGORITHM=HS256
JWT_EXPIRE_DAYS=14

# ── AI provider ──────────────────────────────────────────
# The reviewer-matching / classification agents call OpenAI (gpt-4o-mini +
# text-embedding-3-small). Rotate this key at platform.openai.com whenever
# it may have leaked (it never belongs in git).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The following provider keys are kept for future multi-provider work
# (BACKLOG.md JG-306 / JG-311). They are read into config but no code path
# uses them today. Leave blank.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ── Email (SendGrid / Brevo) ─────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourjournal.org

# ── WhatsApp (Twilio) ────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
EDITOR_WHATSAPP_NUMBER=whatsapp:+1234567890

# ── File Storage (S3-compatible: AWS S3 or Cloudflare R2) ──
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET_NAME=journal-uploads
AWS_REGION=us-east-1

# ── Frontend / CORS / public URLs ────────────────────────
FRONTEND_URL=http://localhost:3000
# Comma-separated list of origins allowed by CORS.
ALLOW_ORIGINS=http://localhost:3000
# Public URL where the API itself is reachable (used to build links in
# outgoing emails, e.g. the CV approval flow).
PUBLIC_API_URL=http://localhost:8000

# Editorial-office inbox — receives copies of CV access requests, etc.
# Leave blank to skip the copy entirely.
EDITORIAL_INBOX_EMAIL=

# ── Plagiarism / Similarity ─────────────────────────────
SIMILARITY_THRESHOLD=0.60

# ── Initial editor seed (opt-in) ────────────────────────
# When BOTH are set AND no editor exists yet, the API creates a single
# initial editor account so a fresh install has a way in. Leave blank in
# production and provision editors manually.
INITIAL_EDITOR_EMAIL=
INITIAL_EDITOR_PASSWORD=

# ── Editor MFA policy ───────────────────────────────────
# Default is safe (false). Set to true ONLY in local dev — this makes
# editor_auth log OTPs to the console AND return them in the login response
# so you can complete MFA without email/SMS set up.
EDITOR_DEV_MODE=false

# ── Deploy-time only ────────────────────────────────────
# Set to 1 in the container's start command to run alembic on boot.
# The recommended pattern is to run migrations as a deploy step instead.
RUN_MIGRATIONS_ON_STARTUP=0
