# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://journal_user:change_me@localhost:5432/journal_db

# ── Authentication / JWT ──────────────────────────────────
SECRET_KEY=change_me_to_a_random_64_char_string__use_openssl_rand_hex_32____
JWT_EXPIRE_DAYS=14

# ── AI (Anthropic / Claude) ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (SendGrid) ─────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourjournal.org

# ── WhatsApp (Twilio) ────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
EDITOR_WHATSAPP_NUMBER=whatsapp:+1234567890

# ── File Storage (AWS S3) ────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET_NAME=journal-uploads
AWS_REGION=us-east-1

# ── Task Queue (Redis / Celery) ──────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── DOI Registration (Crossref) ──────────────────────────
CROSSREF_USERNAME=your_crossref_username
CROSSREF_PASSWORD=your_crossref_password
CROSSREF_DOI_PREFIX=10.xxxxx

# ── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Plagiarism / Similarity ─────────────────────────────
SIMILARITY_THRESHOLD=0.60
